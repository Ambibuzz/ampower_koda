    "fields": [
        {
            "fieldname": "settings_tab",
            "fieldtype": "Tab Break",
            "label": "AI Provider Settings"
        },
        {
            "fieldname": "general_section",
            "fieldtype": "Section Break",
            "label": "General"
        },
        {
            "default": "0",
            "fieldname": "enable_ai_agent",
            "fieldtype": "Check",
            "label": "Enable AI Agent"
        },
        {
            "fieldname": "defaults_section",
            "fieldtype": "Section Break",
            "label": "Defaults",
            "depends_on": "enable_ai_agent"
        },
        {
            "fieldname": "default_ai_provider",
            "fieldtype": "Select",
            "label": "AI Provider",
            "options": "OpenAI\nGemini\nClaude",
            "default": "OpenAI",
            "reqd": 0
        },
        {
            "fieldname": "column_break_defaults",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "default_ai_model",
            "fieldtype": "Select",
            "label": "AI Model",
            "default": "gpt-4o-mini",
            "options": "gpt-4o-mini\ngpt-4o\ngpt-5-mini\no3-mini\ngemini-2.0-flash\ngemini-2.5-pro\nclaude-sonnet-4-20250514\nclaude-3-5-sonnet-20241022\nclaude-3-5-haiku-20241022",
            "description": "Default model for new requests. Changes with provider selection."
        },
        {
            "fieldname": "kg_section",
            "fieldtype": "Section Break",
            "label": "Knowledge Graph",
            "depends_on": "enable_ai_agent"
        },
        {
            "fieldname": "kg_buffer_ttl_seconds",
            "fieldtype": "Int",
            "label": "Buffer TTL (seconds)",
            "default": "86400",
            "description": "How long a cached knowledge graph stays valid before rebuild is required"
        },
        {
            "fieldname": "column_break_kg",
            "fieldtype": "Column Break"
        },
        {
            "default": "1",
            "fieldname": "kg_auto_reference",
            "fieldtype": "Check",
            "label": "Auto-reference Knowledge Graph",
            "description": "If a cached graph exists for the target app at its current commit, use it during requests instead of scanning files blindly"
        },
        {
            "default": "1",
            "fieldname": "kg_auto_build_if_missing",
            "fieldtype": "Check",
            "label": "Auto-build Knowledge Graph if Missing",
            "depends_on": "kg_auto_reference",
            "description": "If no cached graph exists yet, build and cache one automatically before exploration starts. Adds time to the first request on a new app."
        },
        {
            "fieldname": "openai_section",
            "fieldtype": "Section Break",
            "label": "OpenAI",
            "depends_on": "enable_ai_agent",
            "collapsible": 1,
            "collapsible_depends_on": "eval:doc.default_ai_provider !== 'OpenAI'"
        },
        {
            "fieldname": "openai_api_key",
            "fieldtype": "Password",
            "label": "OpenAI API Key",
            "mandatory_depends_on": "eval:doc.default_ai_provider === 'OpenAI'"
        },
        {
            "fieldname": "gemini_section",
            "fieldtype": "Section Break",
            "label": "Google Gemini",
            "depends_on": "enable_ai_agent",
            "collapsible": 1,
            "collapsible_depends_on": "eval:doc.default_ai_provider !== 'Gemini'"
        },
        {
            "fieldname": "google_api_key",
            "fieldtype": "Password",
            "label": "Google API Key",
            "description": "API key from Google AI Studio",
            "mandatory_depends_on": "eval:doc.default_ai_provider === 'Gemini'"
        },
        {
            "fieldname": "claude_section",
            "fieldtype": "Section Break",
            "label": "Claude (Anthropic)",
            "depends_on": "enable_ai_agent",
            "collapsible": 1,
            "collapsible_depends_on": "eval:doc.default_ai_provider !== 'Claude'"
        },
        {
            "fieldname": "anthropic_api_key",
            "fieldtype": "Password",
            "label": "Anthropic API Key",
            "description": "API key from Anthropic console",
            "mandatory_depends_on": "eval:doc.default_ai_provider === 'Claude'"
        }
    ],
